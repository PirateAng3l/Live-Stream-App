<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/splashImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Invisible touch target over the "GET STARTED" button baked into
      splash_background.png. Positioned by percentage guidelines (not fixed dp)
      to track the button's position in that 1080x1920 artwork across screen
      sizes. These percentages were measured directly from the button's neon
      border pixels in the source PNG (button spans roughly y 0.858-0.945,
      x 0.099-0.866 of the image), not eyeballed — update them the same way
      (or re-measure) if the artwork is replaced.
    -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/getStartedTopGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.850" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/getStartedBottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.950" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/getStartedStartGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.085" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/getStartedEndGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <View
        android:id="@+id/getStartedBtn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/get_started"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/getStartedBottomGuide"
        app:layout_constraintEnd_toEndOf="@id/getStartedEndGuide"
        app:layout_constraintStart_toStartOf="@id/getStartedStartGuide"
        app:layout_constraintTop_toTopOf="@id/getStartedTopGuide" />

</androidx.constraintlayout.widget.ConstraintLayout>
