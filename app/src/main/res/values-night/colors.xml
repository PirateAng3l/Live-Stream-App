<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme — the app's original, only look before the swappable theme
     system existed. Values unchanged from before this file existed, so
     anyone who keeps (or defaults to) dark mode sees exactly what they
     always saw. Paired with values/colors.xml (light) via Android's
     day/night resource-qualifier system; which one applies is controlled
     at runtime by AppCompatDelegate.setDefaultNightMode() (see
     BroadcasterApp.kt), not just the system setting — the in-app Dark
     mode switch calls that directly.

     Does NOT affect the broadcast overlay baked into the video itself
     (TeamOverlayRenderer / CricketOverlayRenderer / EventOverlayRenderer /
     OverlayChrome) — those draw with their own hardcoded hex colors,
     never reading from this file. Deliberately: what a viewer sees in the
     stream shouldn't change because the operator's phone is in light or
     dark mode. -->
<resources>
    <color name="background">#0F1620</color>
    <color name="panel_bg">#CC0F1620</color>
    <color name="accent">#E4392F</color>
    <color name="home_color">#2FA8E4</color>
    <color name="away_color">#E4392F</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B7C2CC</color>
    <color name="live_red">#E4392F</color>
    <color name="ok_green">#3ECF6E</color>
    <color name="warn_amber">#F2B33D</color>
    <color name="divider">#26FFFFFF</color>
</resources>
